rules_version = '2';
// Demo / internal tracker: open access so the web app can load data without Firebase Auth setup.
// Tighten to `request.auth != null` once Anonymous sign-in is enabled in Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{activityId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
